---
// Review-only preview of the proposed elective copy. The live /electives page
// is unchanged. Delete this file (and its /zh counterpart) when the proposal is
// shipped or dropped — see src/data/proposed-changes.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import ElectivesPage from "../components/pages/ElectivesPage.astro";
import ReviewBanner from "../components/ReviewBanner.astro";
import { content } from "../i18n/content";
import { electiveOverrides, electivesReviewNotes } from "../data/proposed-changes";
const lang = "en" as const;
const changeCount = Object.keys(electiveOverrides).length;
---

<BaseLayout lang={lang} title={`${content[lang].electives.title} — proposed`} noindex>
  <ReviewBanner
    lang={lang}
    liveRouteKey="electives"
    notes={electivesReviewNotes}
    changeCount={changeCount}
  />
  <ElectivesPage lang={lang} variant="proposed" />
</BaseLayout>
