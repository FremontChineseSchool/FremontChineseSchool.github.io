---
// Review-only preview — see the English counterpart for context.
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeachersPage from "../../components/pages/TeachersPage.astro";
import ReviewBanner from "../../components/ReviewBanner.astro";
import { content } from "../../i18n/content";
import { teacherCourseNotes, teachersReviewNotes } from "../../data/proposed-changes";
const lang = "zh" as const;
const changeCount = Object.keys(teacherCourseNotes).length;
---

<BaseLayout lang={lang} title={`${content[lang].teachers.title}（修訂版）`} noindex>
  <ReviewBanner
    lang={lang}
    liveRouteKey="teachers"
    notes={teachersReviewNotes}
    changeCount={changeCount}
  />
  <TeachersPage lang={lang} variant="proposed" />
</BaseLayout>
