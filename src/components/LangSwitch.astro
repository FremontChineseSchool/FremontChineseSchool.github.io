---
import { alternatePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const target = alternatePath(lang, Astro.url.pathname);
const otherLabel = lang === "en" ? "中文" : "English";
---

<a
  href={target}
  class="rounded border border-white/70 px-2 py-0.5 text-xs font-medium text-white transition hover:bg-white hover:text-fcs-green sm:rounded-full sm:px-3 sm:py-1 sm:text-sm"
  hreflang={lang === "en" ? "zh-Hant" : "en"}
  lang={lang === "en" ? "zh-TW" : "en"}
>
  {otherLabel}
</a>
