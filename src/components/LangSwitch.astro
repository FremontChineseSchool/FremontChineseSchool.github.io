---
import { alternatePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const target = alternatePath(lang, Astro.url.pathname);
const otherLabel = lang === "en" ? "中文" : "English";
---

<a
  href={target}
  class="shrink-0 whitespace-nowrap rounded-full border border-white/70 px-[10px] py-[2px] text-[12px] font-medium text-white transition hover:bg-white hover:text-fcs-green"
  hreflang={lang === "en" ? "zh-Hant" : "en"}
  lang={lang === "en" ? "zh-TW" : "en"}
>
  {otherLabel}
</a>
