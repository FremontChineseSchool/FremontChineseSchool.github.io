---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";
import { electiveOverrides, type ReviewNote as ReviewNoteType } from "../../data/proposed-changes";
import ReviewNote from "../ReviewNote.astro";

interface Props {
  lang: Lang;
  /**
   * "current" (default) renders the live page. "proposed" overlays the staged
   * changes from proposed-changes.ts and annotates what differs — used only by
   * /electives-diff, and removable along with that route.
   */
  variant?: "current" | "proposed";
}
const { lang, variant = "current" } = Astro.props;
const c = content[lang].electives;
const isProposed = variant === "proposed";

type ElectiveClass = (typeof c.slots)[number]["classes"][number];

type Resolved = {
  name: string;
  description: string;
  notes: string | null;
  /** Only the fields that actually differ, holding the CURRENT (live) value. */
  before: { name?: string; description?: string; notes?: string | null };
  changed: boolean;
  review: ReviewNoteType[];
};

// The live content is the "before" — the overlay carries only the new value —
// so a diff needs no second copy of the old text maintained anywhere.
function resolve(cls: ElectiveClass): Resolved {
  const base = {
    name: cls.name,
    description: cls.description,
    notes: (cls.notes ?? null) as string | null,
  };
  const ov = isProposed ? electiveOverrides[cls.code] : undefined;
  if (!ov) return { ...base, before: {}, changed: false, review: [] };

  const next = ov[lang];
  const before: Resolved["before"] = {};
  const merged = { ...base };

  if (next.name !== undefined && next.name !== base.name) {
    before.name = base.name;
    merged.name = next.name;
  }
  if (next.description !== undefined && next.description !== base.description) {
    before.description = base.description;
    merged.description = next.description;
  }
  if (next.notes !== undefined && (next.notes ?? null) !== base.notes) {
    before.notes = base.notes;
    merged.notes = next.notes ?? null;
  }

  return {
    ...merged,
    before,
    changed: Object.keys(before).length > 0,
    review: ov.review ?? [],
  };
}

const beforeLabel = lang === "zh" ? "目前線上版本" : "Currently live";
const changedBadge = lang === "zh" ? "已修改" : "Changed";
const fieldLabels = {
  name: lang === "zh" ? "課程名稱" : "Class name",
  description: lang === "zh" ? "說明" : "Description",
  notes: lang === "zh" ? "備註" : "Notes",
};
---

<section style="background: var(--color-fcs-white);" class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- Material fee note -->
  <p class="mt-5 rounded-[10px] p-4 text-sm" style="background: var(--color-fcs-orange-light); color: var(--color-fcs-muted); border: 1px solid var(--color-fcs-border);">
    <strong style="color: var(--color-fcs-black);">{lang === 'en' ? 'Material fees:' : '教材費說明：'}</strong>{' '}{c.materialFeeNote}
  </p>

  <!-- In-Person Classes -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.inPersonLabel}</h2>
  <div class="mt-6 space-y-10">
    {c.slots.map((slot) => (
      <div>
        <!-- Time slot header -->
        <div class="flex items-center gap-2 border-b pb-2 mb-4" style="border-color: var(--color-fcs-border);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-fcs-green); flex-shrink:0;" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span class="text-sm font-semibold tracking-wide uppercase" style="color: var(--color-fcs-green);">{slot.time}</span>
        </div>

        <!-- Class cards for this slot -->
        <div class="grid gap-4 sm:grid-cols-2">
          {slot.classes.map((cls) => {
            const r = resolve(cls);
            return (
            <div
              class="rounded-[10px] p-5 flex flex-col gap-2"
              style={`background: var(--color-fcs-white); border: 1px solid ${r.changed ? 'var(--color-fcs-gold)' : 'var(--color-fcs-border)'};`}
            >
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block rounded px-1.5 py-0.5 text-xs font-mono font-semibold mb-1" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);">{cls.code}</span>
                  <h3 class="font-semibold text-sm leading-snug" style="color: var(--color-fcs-green-dark);">{r.name}</h3>
                </div>
                <div class="flex gap-1 flex-wrap justify-end shrink-0">
                  {r.changed && (
                    <span class="rounded-full px-2 py-0.5 text-xs font-bold" style="background: var(--color-fcs-gold); color: var(--color-fcs-black);">{changedBadge}</span>
                  )}
                  {cls.isNew && (
                    <span class="rounded-full px-2 py-0.5 text-xs font-bold" style="background: var(--color-fcs-gold); color: var(--color-fcs-black);">{lang === 'en' ? 'NEW' : '新課'}</span>
                  )}
                  {cls.adultsWelcome && (
                    <span class="rounded-full px-2 py-0.5 text-xs font-semibold" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);">{lang === 'en' ? 'Adults ✓' : '成人歡迎'}</span>
                  )}
                </div>
              </div>
              <p class="text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{r.description}</p>
              {cls.materialFee && (
                <p class="text-xs font-semibold mt-auto" style="color: var(--color-fcs-deep-jade);">
                  {lang === 'en' ? 'Material fee: ' : '教材費：'}{cls.materialFee}
                  {cls.materialsNote && <span class="font-normal" style="color: var(--color-fcs-muted);"> — {cls.materialsNote}</span>}
                </p>
              )}
              {!cls.materialFee && cls.materialsNote && (
                <p class="text-xs mt-auto" style="color: var(--color-fcs-muted);">{cls.materialsNote}</p>
              )}
              {r.notes && (
                <p class="text-xs italic" style="color: var(--color-fcs-muted);">{r.notes}</p>
              )}

              {r.changed && (
                <div class="mt-2 space-y-2 border-t pt-3" style="border-color: var(--color-fcs-border);">
                  <p class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-fcs-muted);">{beforeLabel}</p>
                  {(["name", "description", "notes"] as const).map((field) =>
                    field in r.before ? (
                      <p class="text-xs leading-relaxed" style="color: var(--color-fcs-muted);">
                        <span class="font-semibold">{fieldLabels[field]}:</span>{' '}
                        <span style="text-decoration: line-through; text-decoration-color: var(--color-fcs-gold);">
                          {r.before[field] ?? (lang === 'zh' ? '（無）' : '(none)')}
                        </span>
                      </p>
                    ) : null,
                  )}
                  {r.review.map((n) => <ReviewNote lang={lang} level={n.level} text={n[lang]} />)}
                </div>
              )}
            </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <!-- Online Classes -->
  <h2 class="mt-14 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.onlineLabel}</h2>
  <div class="mt-6 space-y-10">
    {c.onlineSlots.map((slot) => (
      <div>
        <div class="flex items-center gap-2 border-b pb-2 mb-4" style="border-color: var(--color-fcs-border);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-fcs-green); flex-shrink:0;" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span class="text-sm font-semibold tracking-wide uppercase" style="color: var(--color-fcs-green);">{slot.time}</span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {slot.classes.map((cls) => {
            const r = resolve(cls);
            return (
            <div
              class="rounded-[10px] p-5 flex flex-col gap-2"
              style={`background: var(--color-fcs-white); border: 1px solid ${r.changed ? 'var(--color-fcs-gold)' : 'var(--color-fcs-border)'};`}
            >
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block rounded px-1.5 py-0.5 text-xs font-mono font-semibold mb-1" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);">{cls.code}</span>
                  <h3 class="font-semibold text-sm leading-snug" style="color: var(--color-fcs-black);">{r.name}</h3>
                </div>
                <div class="flex gap-1 flex-wrap justify-end shrink-0">
                  {r.changed && (
                    <span class="rounded-full px-2 py-0.5 text-xs font-bold" style="background: var(--color-fcs-gold); color: var(--color-fcs-black);">{changedBadge}</span>
                  )}
                  {cls.isNew && (
                    <span class="rounded-full px-2 py-0.5 text-xs font-bold" style="background: var(--color-fcs-gold); color: var(--color-fcs-black);">{lang === 'en' ? 'NEW' : '新課'}</span>
                  )}
                </div>
              </div>
              <p class="text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{r.description}</p>
              {cls.materialFee && (
                <p class="text-xs font-semibold mt-auto" style="color: var(--color-fcs-deep-jade);">
                  {lang === 'en' ? 'Material fee: ' : '教材費：'}{cls.materialFee}
                  {cls.materialsNote && <span class="font-normal" style="color: var(--color-fcs-muted);"> — {cls.materialsNote}</span>}
                </p>
              )}
              {!cls.materialFee && cls.materialsNote && (
                <p class="text-xs mt-auto" style="color: var(--color-fcs-muted);">{cls.materialsNote}</p>
              )}
              {r.notes && (
                <p class="text-xs italic" style="color: var(--color-fcs-muted);">{r.notes}</p>
              )}

              {r.changed && (
                <div class="mt-2 space-y-2 border-t pt-3" style="border-color: var(--color-fcs-border);">
                  <p class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-fcs-muted);">{beforeLabel}</p>
                  {(["name", "description", "notes"] as const).map((field) =>
                    field in r.before ? (
                      <p class="text-xs leading-relaxed" style="color: var(--color-fcs-muted);">
                        <span class="font-semibold">{fieldLabels[field]}:</span>{' '}
                        <span style="text-decoration: line-through; text-decoration-color: var(--color-fcs-gold);">
                          {r.before[field] ?? (lang === 'zh' ? '（無）' : '(none)')}
                        </span>
                      </p>
                    ) : null,
                  )}
                  {r.review.map((n) => <ReviewNote lang={lang} level={n.level} text={n[lang]} />)}
                </div>
              )}
            </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <!-- CTA -->
  <div class="mt-12 flex flex-wrap gap-3">
    <a
      href={localizedPath(lang, 'enroll')}
      class="btn-primary inline-block rounded-[6px] px-5 py-2.5 text-sm font-semibold transition-colors"
    >
      {lang === 'en' ? 'Enroll now →' : '立即報名 →'}
    </a>
    <a
      href={localizedPath(lang, 'enroll')}
      class="inline-block rounded-[6px] px-5 py-2.5 text-sm font-semibold transition-colors"
      style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-green);"
    >
      {lang === 'en' ? 'View enrollment guide →' : '查看報名指南 →'}
    </a>
  </div>
</section>
