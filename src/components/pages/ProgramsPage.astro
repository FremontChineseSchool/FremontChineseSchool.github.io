---
import { content } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].programs;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">Programs</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <div class="mt-10 space-y-6">
    {
      c.sections.map((s) => (
        <div class="rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);">
          <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{s.heading}</h2>
          <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
