---
import { content } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].programs;
---

<section class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-bold sm:text-4xl">{c.title}</h1>
  <p class="mt-4 text-lg text-gray-700">{c.intro}</p>

  <div class="mt-10 space-y-6">
    {
      c.sections.map((s) => (
        <div class="rounded-xl border border-gray-200 p-6">
          <h2 class="text-xl font-semibold text-fcs-blue-dark">{s.heading}</h2>
          <p class="mt-3 leading-relaxed text-gray-700">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
