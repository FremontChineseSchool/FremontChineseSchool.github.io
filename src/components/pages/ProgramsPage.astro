---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].programs;
const t = c.tuition;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">Programs</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <div class="mt-10 space-y-6">
    {
      c.sections.map((s) => (
        <div class="rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);">
          <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{s.heading}</h2>
          <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{s.body}</p>
        </div>
      ))
    }
  </div>

  <!-- Tuition summary -->
  <div class="mt-12 rounded-[10px] p-6 sm:p-8" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-gold);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{t.title}</h2>

    <!-- Early bird callout -->
    <p class="mt-3 rounded-md px-4 py-2 text-sm font-medium" style="background: #FEF3C7; color: #92400E;">
      🎯 {t.earlyBirdNote}
    </p>

    <!-- Fee table -->
    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="border-bottom: 2px solid var(--color-fcs-border);">
            <th class="pb-2 text-left font-semibold" style="color: var(--color-fcs-black);"></th>
            <th class="pb-2 text-right font-semibold" style="color: var(--color-fcs-green-dark);">{t.earlyBirdLabel}</th>
            <th class="pb-2 text-right font-semibold" style="color: var(--color-fcs-muted);">{t.regularLabel}</th>
          </tr>
        </thead>
        <tbody>
          {t.rows.map((row) => (
            <tr style="border-bottom: 1px solid var(--color-fcs-border);">
              <td class="py-3 pr-4 leading-snug" style="color: var(--color-fcs-muted);">{row.track}</td>
              <td class="py-3 text-right font-semibold tabular-nums whitespace-nowrap" style="color: var(--color-fcs-green-dark);">{row.earlyBird}</td>
              <td class="py-3 text-right tabular-nums whitespace-nowrap" style="color: var(--color-fcs-muted);">{row.regular}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Notes -->
    <ul class="mt-4 space-y-1">
      {t.notes.map((note) => (
        <li class="text-xs" style="color: var(--color-fcs-muted);">* {note}</li>
      ))}
    </ul>

    <!-- PDF link -->
    <a
      href={links.tuitionPdf}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold"
      style="color: var(--color-fcs-green);"
    >
      {t.pdfLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    </a>
  </div>
</section>
