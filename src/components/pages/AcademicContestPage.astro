---
import { content } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].academicContest;

const categoryIcons = [
  // microphone / speech
  "M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8",
  // book open / reading
  "M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 1 3-3h7z",
  // pen tool / calligraphy
  "M12 19l7-7 3 3-7 7-3-3zM18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z",
  // clipboard / test
  "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4",
];
---

<section style="background: var(--color-fcs-white);" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">{c.eyebrow}</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- About -->
  <div class="mt-8 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.aboutTitle}</h2>
    <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{c.aboutBody}</p>
  </div>

  <!-- Categories -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.categoriesTitle}</h2>
  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    {c.categories.map((cat, i) => (
      <div class="rounded-[10px] p-5" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green-dark);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={categoryIcons[i]} />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold" style="color: var(--color-fcs-black);">{cat.name}</h3>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{cat.body}</p>
      </div>
    ))}
  </div>

  <!-- Current year resources -->
  <div class="mt-12 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-gold);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.resourcesTitle}</h2>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.resourcesNote}</p>

    <div class="mt-5 space-y-3">
      <!-- Rules — placeholder (disabled) -->
      <span class="inline-flex items-center gap-2 text-sm" style="color: var(--color-fcs-muted); opacity: 0.6;">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        {c.rulesLabel}
      </span>

      <!-- Register — placeholder (disabled) -->
      <span class="inline-flex items-center gap-2 text-sm" style="color: var(--color-fcs-muted); opacity: 0.6;">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        {c.registerLabel}
      </span>

      <!-- Contact email — live -->
      <a
        href="mailto:ac@fremontchineseschool.org"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {c.contactLabel}
      </a>
    </div>
  </div>
</section>
