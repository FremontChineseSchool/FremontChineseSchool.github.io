---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].academicContest;

// Icon per event code (codes match the contest's own event table).
const categoryIcons: Record<string, string> = {
  // speech bubble / impromptu speech
  MI: "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z",
  // clipboard / reading comprehension test
  RC: "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4",
  // microphone / prepared speech
  MS: "M12 2a3 3 0 0 1 3 3v7a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8",
  // open book / read aloud
  FT: "M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z",
  RT: "M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z",
  // pencil / pencil calligraphy
  PW: "M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5ZM15 5l4 4",
  // framed picture / western drawing
  WD: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21",
  // music notes / singing & dancing
  SD: "M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z",
};
---

<section style="background: var(--color-fcs-white);" class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- About -->
  <div class="mt-8 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.aboutTitle}</h2>
    <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{c.aboutBody}</p>
  </div>

  <!-- Age groups (A–D, CD) referenced by each category's "Groups" line -->
  <h2 id="age-groups" class="mt-12 scroll-mt-24 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.ageGroupsTitle}</h2>
  <p class="mt-2 text-sm" style="color: var(--color-fcs-muted);">{c.ageGroupsNote}</p>
  <div class="mt-4 overflow-x-auto rounded-[10px]" style="border: 1px solid var(--color-fcs-border);">
    <table class="w-full text-sm" style="border-collapse: collapse;">
      <thead>
        <tr style="background: var(--color-fcs-green); color: white;">
          <th scope="col" class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">{c.ageGroupsHeaders.group}</th>
          <th scope="col" class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">{c.ageGroupsHeaders.birthDates}</th>
          <th scope="col" class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">{c.ageGroupsHeaders.ages}</th>
        </tr>
      </thead>
      <tbody>
        {c.ageGroups.map((g, i) => (
          <tr style={i > 0 ? "border-top: 1px solid var(--color-fcs-border);" : ""}>
            <th scope="row" class="px-4 py-2.5 text-left font-semibold" style="color: var(--color-fcs-green-dark);">{g.group}</th>
            <td class="whitespace-nowrap px-4 py-2.5 tabular-nums" style="color: var(--color-fcs-black);">{g.birthDates}</td>
            <td class="px-4 py-2.5" style="color: var(--color-fcs-muted);">{g.ages}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Categories -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.categoriesTitle}</h2>
  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    {c.categories.map((cat) => (
      <div class="rounded-[10px] p-5" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green-dark);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={categoryIcons[cat.code]} />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold" style="color: var(--color-fcs-black);">
          <span class="mr-1.5 rounded px-1.5 py-0.5 align-middle font-mono text-xs" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green-dark);">{cat.code}</span>{cat.name}
        </h3>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{cat.body}</p>
        <p class="mt-2 text-sm" style="color: var(--color-fcs-black);">
          <span class="font-semibold" style="color: var(--color-fcs-green-dark);">{c.groupsLabel}{lang === "zh" ? "：" : ": "}</span>{cat.groups}
        </p>
        {"note" in cat && cat.note && (
          <p class="mt-1 text-sm" style="color: var(--color-fcs-muted);">{cat.note}</p>
        )}
        {"topics" in cat && cat.topics && (
          <div class="mt-4 rounded-lg p-3" style="background: var(--color-fcs-green-light);">
            <h4 class="text-xs font-semibold uppercase tracking-wide" style="color: var(--color-fcs-green-dark);">{cat.topicsTitle}</h4>
            <ul class="mt-2 space-y-2">
              {cat.topics.map((t) => (
                <li class="text-sm leading-snug">
                  <span class="font-semibold" style="color: var(--color-fcs-green-dark);">{t.group}{lang === "zh" ? "：" : ": "}</span>
                  <span style="color: var(--color-fcs-black);">{t.text}</span>
                  {"translation" in t && t.translation && (
                    <span class="block text-xs" style="color: var(--color-fcs-muted);">{t.translation}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        {"links" in cat && cat.links && (
          <div class="mt-4 flex flex-col items-start gap-2">
            {cat.links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
                style="color: var(--color-fcs-green);"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- General practice reference for all categories -->
  <div class="mt-5 flex flex-col gap-2 rounded-[10px] p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4" style="background: var(--color-fcs-green-light);">
    <p class="text-sm" style="color: var(--color-fcs-muted);">{c.samplesNote}</p>
    <a
      href={links.contestSamples}
      target="_blank"
      rel="noopener"
      class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      {c.samplesLabel}
    </a>
  </div>

  <!-- Current year resources -->
  <div class="mt-12 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.resourcesTitle}</h2>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.resourcesNote}</p>

    <!-- Key dates for the current year -->
    <h3 class="mt-6 font-semibold" style="color: var(--color-fcs-black);">{c.keyDatesTitle}</h3>
    <dl class="mt-3 divide-y rounded-[10px]" style="border: 1px solid var(--color-fcs-border);">
      {c.keyDates.map((d) => (
        <div class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:gap-4" style="border-color: var(--color-fcs-border);">
          <dt class="text-sm font-semibold sm:w-52 sm:shrink-0" style="color: var(--color-fcs-green-dark);">{d.date}</dt>
          <dd class="text-sm" style="color: var(--color-fcs-muted);">{d.label}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-5 flex flex-col items-start gap-3">
      <!-- Sign up / login — primary action -->
      <a
        href={links.contestLogin}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        {c.registerLabel}
      </a>

      <!-- Rules -->
      <a
        href={links.contestRules}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        {c.rulesLabel}
      </a>

      <!-- Sign-up guide -->
      <a
        href={links.contestSignupGuide}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        {c.signupGuideLabel}
      </a>

      <!-- Contact email — live -->
      <a
        href="mailto:ac@fremontchineseschool.org"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {c.contactLabel}
      </a>
    </div>
  </div>

  <!-- ANCCS regional contest -->
  <div id="anccs" class="mt-8 scroll-mt-24 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.anccsTitle}</h2>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.anccsBody}</p>

    <h3 class="mt-6 font-semibold" style="color: var(--color-fcs-black);">{c.anccsKeyDatesTitle}</h3>
    <dl class="mt-3 divide-y rounded-[10px]" style="border: 1px solid var(--color-fcs-border);">
      {c.anccsKeyDates.map((d) => (
        <div class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:gap-4" style="border-color: var(--color-fcs-border);">
          <dt class="text-sm font-semibold sm:w-52 sm:shrink-0" style="color: var(--color-fcs-green-dark);">{d.date}</dt>
          <dd class="text-sm" style="color: var(--color-fcs-muted);">{d.label}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-5 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.anccsResourcesNote}</p>
    <div class="mt-4 flex flex-col items-start gap-3">
      <a
        href={links.anccsContest}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        {c.anccsLinkLabel}
      </a>
      <a
        href="mailto:ac@fremontchineseschool.org"
        class="inline-flex items-center gap-2 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {c.contactLabel}
      </a>
    </div>
  </div>
</section>
