---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";
import HeroCarousel from "../HeroCarousel.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].events;
---

<!-- Photo carousel banner with the page title overlaid -->
<HeroCarousel lang={lang}>
  <h1 class="text-3xl font-bold text-white drop-shadow-sm sm:text-4xl">
    {c.title}
  </h1>
  <p class="mt-4 max-w-2xl text-lg text-white/95 drop-shadow-sm">{c.intro}</p>
</HeroCarousel>

<section class="mx-auto max-w-3xl px-4 py-14">
  <h2 class="text-xl font-semibold text-fcs-blue-dark" data-reveal>
    {c.annualTitle}
  </h2>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      c.annual.map((e, i) => (
        <li
          class="rounded-lg border border-gray-200 px-4 py-3 text-gray-700 transition duration-300 hover:-translate-y-1 hover:border-fcs-blue hover:shadow-md"
          data-reveal
          style={`--reveal-delay: ${(i % 2) * 90}ms`}
        >
          {e}
        </li>
      ))
    }
  </ul>

  <a
    href={links.facebook}
    target="_blank"
    rel="noopener"
    class="mt-8 inline-block font-semibold text-fcs-blue-dark hover:underline"
    >Facebook →</a
  >
</section>
