---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";
import HeroCarousel from "../HeroCarousel.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].events;
---

<!-- Photo carousel banner with the page title overlaid -->
<HeroCarousel lang={lang}>
  <h1 class="text-3xl font-bold text-white drop-shadow-sm sm:text-4xl">
    {c.title}
  </h1>
  <p class="mt-4 max-w-2xl text-lg text-white/95 drop-shadow-sm">{c.intro}</p>
</HeroCarousel>

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);" data-reveal>
    {c.annualTitle}
  </h2>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      c.annual.map((e, i) => (
        <li
          class="rounded-[10px] px-4 py-3 transition-colors duration-150"
          style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-black);"
          data-reveal
          style={`--reveal-delay: ${(i % 2) * 90}ms`}
        >
          {e}
        </li>
      ))
    }
  </ul>

  <a
    href={links.facebook}
    target="_blank"
    rel="noopener"
    class="mt-8 inline-block font-semibold hover:underline"
    style="color: var(--color-fcs-green);"
  >Facebook →</a>
</section>
