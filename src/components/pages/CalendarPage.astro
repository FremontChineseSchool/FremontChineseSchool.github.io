---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";
import { calendarEntries } from "../../data/calendar-feed";
import type { EventType } from "../../data/calendar-feed";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].calendar;

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' });
}

const sem1 = calendarEntries.filter(e => e.sem === 1);
const sem2 = calendarEntries.filter(e => e.sem === 2);

// Pad the shorter semester so rows align
const maxRows = Math.max(sem1.length, sem2.length);
const rows = Array.from({ length: maxRows }, (_, i) => ({
  left:  sem1[i] ?? null,
  right: sem2[i] ?? null,
}));

const eventColor: Record<EventType, string> = {
  milestone:  'color: var(--color-fcs-black); font-weight: 700;',
  'no-school': 'color: #B23A2C;',
  event:       'color: var(--color-fcs-green);',
  ac:          'color: #6B3A56;',
  exam:        'color: #7E5A05; font-weight: 600;',
  admin:       'color: var(--color-fcs-muted);',
};
---

<section style="background: var(--color-fcs-white);" class="px-4 py-14">
  <div class="mx-auto max-w-5xl">
    <!-- Header -->
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
        <p class="mt-1 text-lg font-medium" style="color: var(--color-fcs-green);">{c.yearLabel}</p>
      </div>
      <span class="text-xs" style="color: var(--color-fcs-muted);">{c.updated}</span>
    </div>

    <!-- Legend -->
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs" style="color: var(--color-fcs-muted);" aria-label="Color legend">
      <span style="color: var(--color-fcs-black); font-weight: 700;"><span aria-hidden="true">● </span>{c.legend.milestone}</span>
      <span style="color: #B23A2C;"><span aria-hidden="true">● </span>{c.legend.noSchool}</span>
      <span style="color: var(--color-fcs-green);"><span aria-hidden="true">● </span>{c.legend.event}</span>
      <span style="color: #6B3A56;"><span aria-hidden="true">● </span>{c.legend.ac}</span>
      <span style="color: #7E5A05; font-weight: 600;"><span aria-hidden="true">● </span>{c.legend.exam}</span>
      <span style="color: var(--color-fcs-muted);"><span aria-hidden="true">● </span>{c.legend.admin}</span>
    </div>

    <!-- Two-column table -->
    <div class="mt-6 overflow-x-auto rounded-[10px]" style="border: 1px solid var(--color-fcs-border);">
      <table class="w-full text-sm" style="border-collapse: collapse; min-width: 560px;">
        <caption class="sr-only">{c.title} — {c.sem1Label} {c.sem1Dates} and {c.sem2Label} {c.sem2Dates}</caption>
        <!-- Column groups for proportional widths -->
        <colgroup>
          <col style="width: 5%;" />
          <col style="width: 11%;" />
          <col style="width: 34%;" />
          <col style="width: 5%;" />
          <col style="width: 11%;" />
          <col style="width: 34%;" />
        </colgroup>
        <thead>
          <tr style="background: var(--color-fcs-green); color: white;">
            <th colspan="3" scope="colgroup" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider">
              {c.sem1Label} · {c.sem1Dates}
            </th>
            <th colspan="3" scope="colgroup" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider" style="border-left: 1px solid rgba(255,255,255,0.2);">
              {c.sem2Label} · {c.sem2Dates}
            </th>
          </tr>
          <tr style="background: var(--color-fcs-white); border-bottom: 2px solid var(--color-fcs-border);">
            {[c.weekLabel, c.dateLabel, c.remarksLabel, c.weekLabel, c.dateLabel, c.remarksLabel].map((h, i) => (
              <th
                scope="col"
                class="px-3 py-1.5 text-left text-xs font-semibold uppercase tracking-wide"
                style={`color: var(--color-fcs-muted);${i === 3 ? ' border-left: 2px solid var(--color-fcs-border);' : ''}`}
              >{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(({ left, right }, idx) => {
            const leftNo  = left?.noSchool  ?? false;
            const rightNo = right?.noSchool ?? false;
            const rowBg = idx % 2 === 0 ? 'var(--color-fcs-white)' : 'var(--color-fcs-surface)';
            return (
              <tr style={`background: ${rowBg};`}>
                {/* ── Left cell ── */}
                <td class="px-3 py-2.5 text-center text-sm" style="color: var(--color-fcs-muted); white-space: nowrap;">
                  {left?.week ?? ''}
                </td>
                <td class="px-3 py-2.5 text-sm font-medium" style={`white-space: nowrap; ${leftNo ? 'color:#B23A2C;' : 'color: var(--color-fcs-black);'}`}>
                  {left ? formatDate(left.date) : ''}
                </td>
                <td class="px-3 py-2.5 text-sm leading-snug">
                  {left?.events.map((ev, ei) => (
                    <span>
                      {ei > 0 && <span style="color: var(--color-fcs-border);"> · </span>}
                      <span style={eventColor[ev.type]}>{lang === 'zh' ? ev.textZh : ev.text}</span>
                    </span>
                  ))}
                </td>
                {/* ── Right cell ── */}
                <td class="px-3 py-2.5 text-center text-sm" style="color: var(--color-fcs-muted); white-space: nowrap; border-left: 2px solid var(--color-fcs-border);">
                  {right?.week ?? ''}
                </td>
                <td class="px-3 py-2.5 text-sm font-medium" style={`white-space: nowrap; ${rightNo ? 'color:#B23A2C;' : 'color: var(--color-fcs-black);'}`}>
                  {right ? formatDate(right.date) : ''}
                </td>
                <td class="px-3 py-2.5 text-sm leading-snug">
                  {right?.events.map((ev, ei) => (
                    <span>
                      {ei > 0 && <span style="color: var(--color-fcs-border);"> · </span>}
                      <span style={eventColor[ev.type]}>{lang === 'zh' ? ev.textZh : ev.text}</span>
                    </span>
                  ))}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Subscribe to Google Calendar -->
    <div class="mt-6 rounded-[10px] p-5" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
      <p class="text-sm font-semibold" style="color: var(--color-fcs-black);">{c.subscribeTitle}</p>
      <p class="mt-1 text-xs" style="color: var(--color-fcs-muted);">{c.subscribeBody}</p>
      <div class="mt-3 flex flex-wrap gap-3">
        <a href="https://calendar.google.com/calendar/r?cid=calendar%40fremontchineseschool.org" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-[6px] px-4 py-2 text-xs font-semibold text-white transition-opacity hover:opacity-90" style="background: #4285F4;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {c.subscribeGoogle}
        </a>
        <a href="https://calendar.google.com/calendar/ical/calendar%40fremontchineseschool.org/public/basic.ics" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-[6px] px-4 py-2 text-xs font-semibold transition-colors" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-black);">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {c.subscribeIcs}
        </a>
      </div>
    </div>

    <!-- Download PDF links -->
    <div class="mt-4 flex flex-wrap gap-4">
      <a href={links.calendarEn} target="_blank" rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {c.downloadEn}
      </a>
      <a href={links.calendarZh} target="_blank" rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {c.downloadZh}
      </a>
    </div>
  </div>
</section>
