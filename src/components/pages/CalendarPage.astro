---
import { content, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";
import { calendarEntries } from "../../data/calendar";
import type { EventType } from "../../data/calendar";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].calendar;

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' });
}

const sem1 = calendarEntries.filter(e => e.sem === 1);
const sem2 = calendarEntries.filter(e => e.sem === 2);

// Pad the shorter semester so rows align
const maxRows = Math.max(sem1.length, sem2.length);
const rows = Array.from({ length: maxRows }, (_, i) => ({
  left:  sem1[i] ?? null,
  right: sem2[i] ?? null,
}));

const eventColor: Record<EventType, string> = {
  milestone:  'color: var(--color-fcs-black); font-weight: 700;',
  'no-school': 'color: #B91C1C;',
  event:       'color: #166534;',
  ac:          'color: #1D4ED8;',
  exam:        'color: #92400E; font-weight: 600;',
  admin:       'color: #6B7280;',
};
---

<section style="background: #FFF8F0;" class="px-4 py-14">
  <div class="mx-auto max-w-5xl">
    <!-- Header -->
    <p class="eyebrow mb-3">Calendar</p>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
        <p class="mt-1 text-lg font-medium" style="color: var(--color-fcs-green);">{c.yearLabel}</p>
      </div>
      <span class="text-xs" style="color: var(--color-fcs-muted);">{c.updated}</span>
    </div>

    <!-- Legend -->
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs" style="color: var(--color-fcs-muted);">
      <span style="color: var(--color-fcs-black); font-weight: 700;">● {c.legend.milestone}</span>
      <span style="color: #B91C1C;">● {c.legend.noSchool}</span>
      <span style="color: #166534;">● {c.legend.event}</span>
      <span style="color: #1D4ED8;">● {c.legend.ac}</span>
      <span style="color: #92400E; font-weight: 600;">● {c.legend.exam}</span>
      <span style="color: #6B7280;">● {c.legend.admin}</span>
    </div>

    <!-- Two-column table -->
    <div class="mt-6 overflow-x-auto rounded-[10px]" style="border: 1px solid var(--color-fcs-border);">
      <table class="w-full text-sm" style="border-collapse: collapse; min-width: 560px;">
        <!-- Column groups for proportional widths -->
        <colgroup>
          <col style="width: 5%;" />
          <col style="width: 11%;" />
          <col style="width: 34%;" />
          <col style="width: 5%;" />
          <col style="width: 11%;" />
          <col style="width: 34%;" />
        </colgroup>
        <thead>
          <tr style="background: var(--color-fcs-green); color: white;">
            <th colspan="3" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider">
              {c.sem1Label} · {c.sem1Dates}
            </th>
            <th colspan="3" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider" style="border-left: 1px solid rgba(255,255,255,0.2);">
              {c.sem2Label} · {c.sem2Dates}
            </th>
          </tr>
          <tr style="background: var(--color-fcs-white); border-bottom: 2px solid var(--color-fcs-border);">
            {['Wk', 'Date', 'Remarks', 'Wk', 'Date', 'Remarks'].map((h, i) => (
              <th
                class="px-3 py-1.5 text-left text-xs font-semibold uppercase tracking-wide"
                style={`color: var(--color-fcs-muted);${i === 3 ? ' border-left: 2px solid var(--color-fcs-border);' : ''}`}
              >{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(({ left, right }, idx) => {
            const leftNo  = left?.noSchool  ?? false;
            const rightNo = right?.noSchool ?? false;
            const rowBg = idx % 2 === 0 ? 'var(--color-fcs-white)' : '#FAFAF8';
            return (
              <tr style={`background: ${rowBg};`}>
                {/* ── Left cell ── */}
                <td class="px-3 py-2 text-center text-xs" style="color: var(--color-fcs-muted); white-space: nowrap;">
                  {left?.week ?? ''}
                </td>
                <td class="px-3 py-2 text-xs font-medium" style={`white-space: nowrap; ${leftNo ? 'color:#B91C1C;' : 'color: var(--color-fcs-black);'}`}>
                  {left ? formatDate(left.date) : ''}
                </td>
                <td class="px-3 py-2 text-xs leading-snug">
                  {left?.events.map((ev, ei) => (
                    <span>
                      {ei > 0 && <span style="color: var(--color-fcs-border);"> · </span>}
                      <span style={eventColor[ev.type]}>{lang === 'zh' ? ev.textZh : ev.text}</span>
                    </span>
                  ))}
                </td>
                {/* ── Right cell ── */}
                <td class="px-3 py-2 text-center text-xs" style="color: var(--color-fcs-muted); white-space: nowrap; border-left: 2px solid var(--color-fcs-border);">
                  {right?.week ?? ''}
                </td>
                <td class="px-3 py-2 text-xs font-medium" style={`white-space: nowrap; ${rightNo ? 'color:#B91C1C;' : 'color: var(--color-fcs-black);'}`}>
                  {right ? formatDate(right.date) : ''}
                </td>
                <td class="px-3 py-2 text-xs leading-snug">
                  {right?.events.map((ev, ei) => (
                    <span>
                      {ei > 0 && <span style="color: var(--color-fcs-border);"> · </span>}
                      <span style={eventColor[ev.type]}>{lang === 'zh' ? ev.textZh : ev.text}</span>
                    </span>
                  ))}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Download links -->
    <div class="mt-6 flex flex-wrap gap-4">
      <a href={links.calendarEn} target="_blank" rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {c.downloadEn}
      </a>
      <a href={links.calendarZh} target="_blank" rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
        style="color: var(--color-fcs-green);">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {c.downloadZh}
      </a>
    </div>
  </div>
</section>
