---
import { content } from "../../i18n/content";
import { type Lang } from "../../i18n/ui";
import { teachersByGroup, groupLabels, classLabel, defaultPhotoFocus } from "../../data/teachers";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].teachers;
const isZh = lang === "zh";

// Monogram stand-in until a consistent photo set exists. The Chinese surname
// (one character, or two for the handful of compound surnames we might see) is
// the most legible mark at this size in either locale.
const monogram = (nameZh: string) => nameZh.slice(0, 1);

// Chinese convention puts the honorific after the name; English puts Ms./Mr.
// in front, so nameEn already carries it.
const displayName = (t: { nameZh: string; nameEn: string }) =>
  isZh ? `${t.nameZh} 老師` : t.nameEn;
const secondaryName = (t: { nameZh: string; nameEn: string }) =>
  isZh ? t.nameEn : `${t.nameZh} 老師`;

const courseNotesLabel = isZh ? "本學年課程重點" : "What this year covers";
const emailLabelFor = (name: string) => (isZh ? `寄信給${name}` : `Email ${name}`);
---

<section style="background: var(--color-fcs-white);" class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- Section jump links — 25 cards is a long scroll, and families arrive
       looking for one specific teacher. -->
  <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={c.jumpLabel}>
    <span class="text-xs font-semibold uppercase tracking-wide" style="color: var(--color-fcs-muted);">{c.jumpLabel}</span>
    {teachersByGroup.map(({ group }) => (
      <a
        href={`#${group}`}
        class="rounded-full px-3 py-1 text-xs font-semibold transition-colors hover:underline"
        style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);"
      >
        {groupLabels[group][lang]}
      </a>
    ))}
  </nav>

  {teachersByGroup.map(({ group, members }) => (
    <div class="mt-12">
      <h2
        id={group}
        class="scroll-mt-24 border-b pb-2 text-xl font-semibold"
        style="border-color: var(--color-fcs-border); color: var(--color-fcs-black);"
      >
        {groupLabels[group][lang]}
      </h2>

      <div class="mt-6 space-y-4">
        {members.map((t) => (
          <article
            id={t.id}
            class="scroll-mt-24 rounded-[10px] p-5 sm:p-6"
            style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);"
          >
            <div class="flex items-start gap-4">
              {/* The photos are not a consistent set (see teachers.ts), so they
                  are shown object-fit: cover inside a circle — cropped, never
                  stretched — with a per-photo object-position where the default
                  framing cuts badly. alt is empty on purpose: the name sits
                  immediately beside it, so a description would just repeat it. */}
              {t.photo ? (
                <img
                  src={t.photo}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-full object-cover sm:h-20 sm:w-20"
                  style={`object-position: ${t.photoFocus ?? defaultPhotoFocus}; border: 1px solid var(--color-fcs-border); background: var(--color-fcs-green-light);`}
                />
              ) : (
                <div
                  class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full text-xl font-semibold sm:h-20 sm:w-20 sm:text-2xl"
                  style="background: var(--color-fcs-green-light); color: var(--color-fcs-green); border: 1px solid var(--color-fcs-border);"
                  aria-hidden="true"
                >
                  {monogram(t.nameZh)}
                </div>
              )}

              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold leading-tight" style="color: var(--color-fcs-green-dark);">
                  {displayName(t)}
                </h3>
                <p class="mt-0.5 text-sm" style="color: var(--color-fcs-muted);">{secondaryName(t)}</p>

                <!-- Class codes only. Rooms and times live on the class
                     schedule (student-resources), which stays the one place
                     they are maintained. -->
                <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={c.teachesLabel}>
                  {t.classes.map((code) => (
                    <li
                      class="inline-flex items-center gap-1.5 rounded-full py-1 pl-1.5 pr-3 text-xs"
                      style="background: var(--color-fcs-surface); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-muted);"
                    >
                      <span
                        class="rounded px-1.5 py-0.5 font-mono text-xs font-semibold"
                        style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);"
                      >{code}</span>
                      {classLabel(code, lang)}
                    </li>
                  ))}
                </ul>

                {t.tagline && (
                  <p class="mt-4 text-sm font-semibold" style="color: var(--color-fcs-deep-jade);">
                    {t.tagline[lang]}
                  </p>
                )}

                {t.bio ? (
                  <p class="mt-2 leading-relaxed" style="color: var(--color-fcs-muted);">{t.bio[lang]}</p>
                ) : (
                  <p class="mt-4 text-sm italic" style="color: var(--color-fcs-muted);">{c.bioPending}</p>
                )}

                <!-- Collapsed by default: only 10 of the 23 language and AC
                     classes have notes, and a closed disclosure keeps the
                     roster scannable while making the gaps unremarkable.
                     Native <details> needs no JS and is keyboard-accessible. -->
                {t.courseNotes && (
                  <details class="fcs-course-notes mt-4 rounded-[8px]" style="background: var(--color-fcs-surface); border: 1px solid var(--color-fcs-border);">
                    <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-semibold" style="color: var(--color-fcs-green);">
                      <span class="fcs-course-notes__marker" aria-hidden="true">▸</span>
                      {courseNotesLabel}
                    </summary>
                    <div class="space-y-4 px-4 pb-4 pt-1">
                      {t.courseNotes.map((n) => (
                        <div>
                          <p class="text-xs font-semibold" style="color: var(--color-fcs-deep-jade);">
                            <span class="font-mono">{n.code}</span> · {classLabel(n.code, lang)}
                          </p>
                          <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{n[lang]}</p>
                        </div>
                      ))}
                    </div>
                  </details>
                )}

                <a
                  href={`mailto:${t.email}`}
                  class="mt-4 inline-flex min-w-0 items-center gap-1.5 text-sm font-medium hover:underline"
                  style="color: var(--color-fcs-green); overflow-wrap: anywhere;"
                  aria-label={emailLabelFor(displayName(t))}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  {t.email}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}

  <p class="mt-10 text-sm" style="color: var(--color-fcs-muted);">{c.scheduleNote}</p>
</section>

<style>
  /* Replace the native disclosure triangle with our own so it can be coloured
     and rotated consistently across browsers (Safari still renders the default
     marker without the -webkit- rule). */
  .fcs-course-notes summary::-webkit-details-marker { display: none; }
  .fcs-course-notes__marker {
    display: inline-block;
    margin-right: 0.35rem;
    transition: transform 150ms ease;
  }
  .fcs-course-notes[open] .fcs-course-notes__marker { transform: rotate(90deg); }
  @media (prefers-reduced-motion: reduce) {
    .fcs-course-notes__marker { transition: none; }
  }
</style>
