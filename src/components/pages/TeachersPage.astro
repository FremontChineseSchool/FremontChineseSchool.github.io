---
import { content } from "../../i18n/content";
import { type Lang } from "../../i18n/ui";
import { teachersByGroup, groupLabels, classLabel } from "../../data/teachers";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].teachers;
const isZh = lang === "zh";

// Monogram stand-in until a consistent photo set exists. The Chinese surname
// (one character, or two for the handful of compound surnames we might see) is
// the most legible mark at this size in either locale.
const monogram = (nameZh: string) => nameZh.slice(0, 1);

// Chinese convention puts the honorific after the name; English puts Ms./Mr.
// in front, so nameEn already carries it.
const displayName = (t: { nameZh: string; nameEn: string }) =>
  isZh ? `${t.nameZh} 老師` : t.nameEn;
const secondaryName = (t: { nameZh: string; nameEn: string }) =>
  isZh ? t.nameEn : `${t.nameZh} 老師`;
---

<section style="background: var(--color-fcs-white);" class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- Work-in-progress note: several introductions and all photos are still
       outstanding, and saying so is better than looking half-finished. -->
  <p class="mt-5 rounded-[10px] p-4 text-sm" style="background: var(--color-fcs-orange-light); color: var(--color-fcs-muted); border: 1px solid var(--color-fcs-border);">
    {c.note}
  </p>

  <!-- Section jump links — 25 cards is a long scroll, and families arrive
       looking for one specific teacher. -->
  <nav class="mt-8 flex flex-wrap items-center gap-2" aria-label={c.jumpLabel}>
    <span class="text-xs font-semibold uppercase tracking-wide" style="color: var(--color-fcs-muted);">{c.jumpLabel}</span>
    {teachersByGroup.map(({ group }) => (
      <a
        href={`#${group}`}
        class="rounded-full px-3 py-1 text-xs font-semibold transition-colors hover:underline"
        style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);"
      >
        {groupLabels[group][lang]}
      </a>
    ))}
  </nav>

  {teachersByGroup.map(({ group, members }) => (
    <div class="mt-12">
      <h2
        id={group}
        class="scroll-mt-24 border-b pb-2 text-xl font-semibold"
        style="border-color: var(--color-fcs-border); color: var(--color-fcs-black);"
      >
        {groupLabels[group][lang]}
      </h2>

      <div class="mt-6 space-y-4">
        {members.map((t) => (
          <article
            id={t.id}
            class="scroll-mt-24 rounded-[10px] p-5 sm:p-6"
            style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);"
          >
            <div class="flex items-start gap-4">
              <!-- Monogram placeholder. aria-hidden: it repeats the name that
                   follows it, so a screen reader gains nothing from it. -->
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-lg font-semibold sm:h-14 sm:w-14 sm:text-xl"
                style="background: var(--color-fcs-green-light); color: var(--color-fcs-green); border: 1px solid var(--color-fcs-border);"
                aria-hidden="true"
              >
                {monogram(t.nameZh)}
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold leading-tight" style="color: var(--color-fcs-green-dark);">
                  {displayName(t)}
                </h3>
                <p class="mt-0.5 text-sm" style="color: var(--color-fcs-muted);">{secondaryName(t)}</p>

                <!-- Class codes only. Rooms and times live on the class
                     schedule (student-resources), which stays the one place
                     they are maintained. -->
                <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={c.teachesLabel}>
                  {t.classes.map((code) => (
                    <li
                      class="inline-flex items-center gap-1.5 rounded-full py-1 pl-1.5 pr-3 text-xs"
                      style="background: var(--color-fcs-surface); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-muted);"
                    >
                      <span
                        class="rounded px-1.5 py-0.5 font-mono text-xs font-semibold"
                        style="background: var(--color-fcs-green-light); color: var(--color-fcs-green);"
                      >{code}</span>
                      {classLabel(code, lang)}
                    </li>
                  ))}
                </ul>

                {t.tagline && (
                  <p class="mt-4 text-sm font-semibold" style="color: var(--color-fcs-deep-jade);">
                    {t.tagline[lang]}
                  </p>
                )}

                {t.bio ? (
                  <p class="mt-2 leading-relaxed" style="color: var(--color-fcs-muted);">{t.bio[lang]}</p>
                ) : (
                  <p class="mt-4 text-sm italic" style="color: var(--color-fcs-muted);">{c.bioPending}</p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}

  <p class="mt-10 text-sm" style="color: var(--color-fcs-muted);">{c.scheduleNote}</p>
</section>
