---
import { content, contactInfo } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].donate;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">Donate</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>

  <div class="mt-6 space-y-4">
    {c.body.map((p) => <p class="leading-relaxed" style="color: var(--color-fcs-muted);">{p}</p>)}
  </div>

  <div class="mt-10 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-gold);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">
      {c.sponsorHeading}
    </h2>
    <p class="mt-3" style="color: var(--color-fcs-muted);">{c.sponsorBody}</p>
    <a
      href={`mailto:${contactInfo.principal}`}
      class="mt-3 inline-block font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >{c.contactEmailLabel}: {contactInfo.principal}</a>
  </div>
</section>
