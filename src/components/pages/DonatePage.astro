---
import { content, contactInfo, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].donate;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">{c.eyebrow}</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>

  <div class="mt-6 space-y-4">
    {c.body.map((p) => <p class="leading-relaxed" style="color: var(--color-fcs-muted);">{p}</p>)}
  </div>

  <!-- EIN / Tax info card -->
  <div class="mt-8 rounded-[10px] p-5" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
    <h2 class="text-base font-semibold" style="color: var(--color-fcs-black);">{c.einHeading}</h2>
    <p class="mt-2 text-sm" style="color: var(--color-fcs-muted);">
      <span class="font-semibold" style="color: var(--color-fcs-black);">{c.einLabel}:</span> {c.einNumber}
    </p>
    <a
      href={links.irsDetermination}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >
      {c.irsLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  </div>

  <div class="mt-6 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-gold);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">
      {c.sponsorHeading}
    </h2>
    <p class="mt-3" style="color: var(--color-fcs-muted);">{c.sponsorBody}</p>
    <a
      href={`mailto:${contactInfo.principal}`}
      class="mt-3 inline-block font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >{c.contactEmailLabel}: {contactInfo.principal}</a>
  </div>
</section>
