---
import { content, contactInfo, links } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].contact;
const L = c.labels;

const principalName =
  lang === "zh"
    ? `${contactInfo.principalNameZh} (${contactInfo.principalName})`
    : `${contactInfo.principalName} (${contactInfo.principalNameZh})`;

const rows = [
  {
    label: L.principal,
    value: `${principalName} — ${contactInfo.principal}`,
    href: `mailto:${contactInfo.principal}`,
  },
  {
    label: L.office,
    value: contactInfo.office,
    href: `mailto:${contactInfo.office}`,
  },
  {
    label: L.registration,
    value: contactInfo.registration,
    href: `mailto:${contactInfo.registration}`,
  },
  { label: L.voicemail, value: contactInfo.voicemail, href: null },
  { label: L.mailing, value: contactInfo.mailing, href: null },
  { label: L.classroom, value: contactInfo.classroom, href: null },
  { label: L.facebook, value: "facebook.com/fremontchineseschool", href: links.facebook },
];
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">Contact</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>

  <dl class="mt-8" style="border-top: 1px solid var(--color-fcs-border);">
    {
      rows.map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-3" style="border-bottom: 1px solid var(--color-fcs-border);">
          <dt class="font-semibold" style="color: var(--color-fcs-muted);">{r.label}</dt>
          <dd class="sm:col-span-2">
            {r.href ? (
              <a
                href={r.href}
                target={r.href.startsWith("http") ? "_blank" : undefined}
                rel={r.href.startsWith("http") ? "noopener" : undefined}
                class="hover:underline"
                style="color: var(--color-fcs-green);"
              >
                {r.value}
              </a>
            ) : (
              <span style="color: var(--color-fcs-black);">{r.value}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
