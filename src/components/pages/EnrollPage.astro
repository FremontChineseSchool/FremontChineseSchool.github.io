---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].enroll;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">Enroll</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <ol class="mt-10 space-y-6">
    {
      c.steps.map((step, i) => (
        <li class="flex gap-4">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full font-bold text-white" style="background: var(--color-fcs-green);">
            {i + 1}
          </span>
          <div>
            <h2 class="text-lg font-semibold" style="color: var(--color-fcs-black);">{step.heading}</h2>
            <p class="mt-1" style="color: var(--color-fcs-muted);">{step.body}</p>
            {"route" in step && step.route ? (
              <a
                href={localizedPath(lang, step.route)}
                class="mt-2 inline-block font-semibold hover:underline"
                style="color: var(--color-fcs-green);"
              >
                {step.linkLabel} →
              </a>
            ) : "link" in step && step.link ? (
              <a
                href={links[step.link as keyof typeof links]}
                target="_blank"
                rel="noopener"
                class="mt-2 inline-block font-semibold hover:underline"
                style="color: var(--color-fcs-green);"
              >
                {step.linkLabel} →
              </a>
            ) : null}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-10 rounded-[10px] p-4 text-sm" style="background: var(--color-fcs-green-light); color: var(--color-fcs-muted); border: 1px solid var(--color-fcs-border);">
    {c.calendarNote}{" "}
    <a
      href={localizedPath(lang, "calendar")}
      class="font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >{content[lang].calendar.title} →</a>
  </p>
</section>
