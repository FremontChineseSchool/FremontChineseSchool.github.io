---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].enroll;
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">{lang === 'en' ? 'Enroll' : '報名'}</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>
  <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.intro}</p>

  <!-- New family pre-flight note -->
  <div class="mt-6 flex items-start gap-3 rounded-[10px] px-4 py-3" style="background: #EFF6FF; border: 1px solid #BFDBFE;">
    <span style="color: #2563EB; flex-shrink:0; margin-top:2px;">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </span>
    <p class="text-sm" style="color: #1e40af;">
      {c.newFamilyNote}
    </p>
  </div>

  <!-- Steps -->
  <h2 class="mt-10 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.stepsTitle}</h2>
  <ol class="mt-6 space-y-6">
    {
      c.steps.map((step, i) => (
        <li class="flex gap-4">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full font-bold text-white" style="background: var(--color-fcs-green);">
            {i + 1}
          </span>
          <div>
            <h3 class="text-lg font-semibold" style="color: var(--color-fcs-black);">{step.heading}</h3>
            <p class="mt-1" style="color: var(--color-fcs-muted);">{step.body}</p>
            {"route" in step && step.route ? (
              <a
                href={localizedPath(lang, step.route)}
                class="mt-2 inline-block font-semibold hover:underline"
                style="color: var(--color-fcs-green);"
              >
                {step.linkLabel} →
              </a>
            ) : "link" in step && step.link ? (
              <a
                href={links[step.link as keyof typeof links]}
                target="_blank"
                rel="noopener"
                class="mt-2 inline-block font-semibold hover:underline"
                style="color: var(--color-fcs-green);"
              >
                {step.linkLabel} →
              </a>
            ) : null}
          </div>
        </li>
      ))
    }
  </ol>

  <!-- Returning student callout -->
  <div class="mt-6 rounded-[10px] px-4 py-3 text-sm" style="background: var(--color-fcs-green-light); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-muted);">
    {c.returningNote}{" "}
    <a href={links.addDropTransfer} target="_blank" rel="noopener" class="font-semibold hover:underline" style="color: var(--color-fcs-green);">{c.returningLinkLabel} →</a>
  </div>

  <!-- Volunteer hours — surfaced early so families know before committing -->
  <div class="mt-8 flex gap-4 rounded-[10px] p-5" style="background: var(--color-fcs-green-light); border: 1px solid var(--color-fcs-border); border-left: 4px solid var(--color-fcs-green);">
    <span style="flex-shrink:0; margin-top:2px; color: var(--color-fcs-green);">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </span>
    <div>
      <h2 class="font-semibold" style="color: var(--color-fcs-black);">{c.volunteerTitle}</h2>
      <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.volunteerBody}</p>
    </div>
  </div>

  <!-- Key Dates -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.keyDatesTitle}</h2>
  <div class="mt-4 space-y-3">
    {c.keyDates.map((d) => (
      <div class="flex gap-4 rounded-[10px] px-4 py-3" style="background: #FFFBEB; border: 1px solid #FDE68A;">
        <span style="color: #D97706; flex-shrink:0; margin-top:2px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold" style="color: #92400E;">{d.label}: <span style="color: #B45309;">{d.date}</span></p>
          <p class="mt-0.5 text-xs" style="color: #92400E;">{d.note}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Grade placement -->
  <div class="mt-12 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.placementTitle}</h2>
    <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{c.placementBody}</p>
    <a href={links.gradeChart} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--color-fcs-green);">
      {c.placementLinkLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    </a>
  </div>

  <!-- Electives -->
  <div class="mt-6 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{c.electivesTitle}</h2>
    <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{c.electivesBody}</p>
    <a href={links.electiveList} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--color-fcs-green);">
      {c.electivesLinkLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  </div>

  <!-- FAQ -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.faqTitle}</h2>
  <div class="mt-4 divide-y" style="border: 1px solid var(--color-fcs-border); border-radius: 10px; overflow: hidden;">
    {c.faq.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold select-none" style="color: var(--color-fcs-black);">
          {item.q}
          <svg class="flex-shrink-0 transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-fcs-green);"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <p class="px-5 pb-4 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{item.a}</p>
      </details>
    ))}
  </div>

  <!-- Withdrawal & Refund Policy -->
  <div class="mt-10 rounded-[10px] p-6" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-gold);">
    <h2 class="text-xl font-semibold" style="color: var(--color-fcs-black);">{c.refundTitle}</h2>
    <p class="mt-2 text-sm" style="color: var(--color-fcs-muted);">{c.refundPaymentNote}</p>
    <div class="mt-4 space-y-2">
      {c.refundTiers.map((tier) => (
        <div
          class="flex flex-col gap-0.5 rounded-[6px] px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
          style={tier.highlight
            ? 'background: #DCFCE7; border: 1px solid #86EFAC;'
            : 'background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);'}
        >
          <span class="text-sm font-semibold" style={tier.highlight ? 'color: #166534;' : `color: var(--color-fcs-black);`}>{tier.period}</span>
          <span class="text-sm" style={tier.highlight ? 'color: #166534;' : `color: var(--color-fcs-muted);`}>{tier.rule}</span>
        </div>
      ))}
    </div>
    <p class="mt-3 text-xs" style="color: var(--color-fcs-muted);">{c.refundContact}</p>
  </div>


  <!-- Resources grid -->
  <h2 class="mt-12 text-xl font-semibold" style="color: var(--color-fcs-black);">{c.resourcesTitle}</h2>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {c.resources.map((r) => (
      <a
        href={links[r.link as keyof typeof links]}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 rounded-[10px] px-4 py-3 text-sm font-semibold transition-colors hover:underline"
        style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); color: var(--color-fcs-green);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        {r.label}
      </a>
    ))}
  </div>

  <!-- Calendar note -->
  <p class="mt-10 rounded-[10px] p-4 text-sm" style="background: var(--color-fcs-green-light); color: var(--color-fcs-muted); border: 1px solid var(--color-fcs-border);">
    {c.calendarNote}{" "}
    <a href={localizedPath(lang, "calendar")} class="font-semibold hover:underline" style="color: var(--color-fcs-green);">{content[lang].calendar.title} →</a>
  </p>
</section>
