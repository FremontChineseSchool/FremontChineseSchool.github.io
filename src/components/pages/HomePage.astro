---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";
import HeroCarousel from "../HeroCarousel.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home;
const events = content[lang].events;

// Simple line icons paired with the four value props, in order.
const featureIcons = [
  // community / people
  "M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m3-1.13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-4a3 3 0 1 0 0-6",
  // badge / accreditation
  "m9 12 2 2 4-4m-3-7.5 2.1 1.5 2.6-.2 1 2.4 2.2 1.4-.6 2.5.6 2.5-2.2 1.4-1 2.4-2.6-.2L12 21.5l-2.1-1.5-2.6.2-1-2.4L4.1 16l.6-2.5L4.1 11l2.2-1.4 1-2.4 2.6.2L12 2.5Z",
  // layers / levels
  "m12 2 9 5-9 5-9-5 9-5Zm9 11-9 5-9-5m18 4-9 5-9-5",
  // sparkle / celebration
  "M12 3v4m0 10v4M3 12h4m10 0h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18",
];
---

<!-- Hero with rotating photo backdrop -->
<HeroCarousel lang={lang}>
  <h1
    class="max-w-3xl text-5xl font-extrabold text-white drop-shadow-sm sm:text-6xl lg:text-7xl"
    style="font-family: var(--font-display-en); letter-spacing: -0.03em;"
  >
    {c.heroTitle}
  </h1>
  <p class="mt-5 max-w-2xl text-xl text-white/95 drop-shadow-sm">
    {c.heroSubtitle}
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={links.register}
      class="rounded-[6px] bg-fcs-orange px-6 py-3 font-semibold text-fcs-white transition-colors duration-150 hover:bg-[#C85A10]"
    >{c.ctaPrimary}</a>
    <a
      href={localizedPath(lang, "programs")}
      class="rounded-[6px] border border-white/70 px-6 py-3 font-semibold text-white transition-colors duration-150 hover:bg-white/10"
    >{c.ctaSecondary}</a>
  </div>
</HeroCarousel>

<!-- Facts strip -->
<section style="background: var(--color-fcs-green-dark);">
  <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-y sm:grid-cols-4 sm:divide-y-0" style="divide-color: rgba(255,255,255,0.12);">
    {c.facts.map((f, i) => (
      <div
        class="flex flex-col items-center justify-center px-6 py-10 text-center"
        data-reveal
        style={`--reveal-delay: ${i * 80}ms;${i > 0 ? ' border-left: 1px solid rgba(255,255,255,0.12);' : ''}`}
      >
        <div class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl" style="letter-spacing: -0.02em;">
          {f.value}
        </div>
        <div class="mt-1.5 text-[10px] font-semibold uppercase tracking-widest" style="color: rgba(255,255,255,0.6);">
          {f.label}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Why FCS — value props (odd section → fcs-white bg) -->
<section style="background: #FFF8F0;">
  <div class="mx-auto max-w-6xl px-4 py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3">Why FCS</p>
      <h2 class="text-4xl font-bold sm:text-5xl" style="letter-spacing: -0.03em; color: var(--color-fcs-black);">{c.featuresTitle}</h2>
      <p class="mt-4 text-lg" style="color: var(--color-fcs-muted);">{c.featuresSubtitle}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.features.map((f, i) => (
          <div
            class="rounded-[10px] p-4 transition-colors duration-150"
            style={`background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border); border-top: 5px solid var(--color-fcs-green);`}
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-xl" style="background: var(--color-fcs-green-light); color: var(--color-fcs-green-dark);">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={featureIcons[i]} />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold" style="color: var(--color-fcs-black);">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Culture section -->
<section style="background: #1A3D22;">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <!-- Header -->
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3" style="color: var(--color-fcs-gold);">{lang === 'en' ? 'Life at FCS' : '校園生活'}</p>
      <h2 class="text-4xl font-bold text-white sm:text-5xl" style="letter-spacing: -0.03em;">{c.cultureTitle}</h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: rgba(255,255,255,0.75);">{c.cultureSubtitle}</p>
    </div>

    <!-- 3 featured photos -->
    <div class="mt-12 grid gap-4 sm:grid-cols-3" data-reveal>
      {c.cultureHighlights.map((h) => (
        <div class="overflow-hidden rounded-[12px]" style="aspect-ratio: 4/3;">
          <img
            src={h.photo}
            alt={h.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          />
        </div>
      ))}
    </div>

    <!-- Label row -->
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {c.cultureHighlights.map((h) => (
        <p class="text-center text-sm font-semibold" style="color: var(--color-fcs-gold);">{h.label}</p>
      ))}
    </div>

    <!-- Annual traditions grid -->
    <div class="mt-14 border-t pt-12" style="border-color: rgba(255,255,255,0.12);">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h3 class="text-2xl font-bold text-white" style="letter-spacing: -0.02em;">{c.eventsTitle}</h3>
        <a
          href={localizedPath(lang, "events")}
          class="inline-flex items-center gap-1 text-sm font-semibold hover:underline"
          style="color: var(--color-fcs-gold);"
        >
          {c.eventsCta}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {events.annual.map((e, i) => (
          <div
            class="rounded-[8px] px-4 py-3"
            style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);"
            data-reveal
          >
            <span class="text-sm font-medium text-white">{e.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>


<!-- Get-started cards -->
<section style="background: linear-gradient(to bottom, #F0F7F2, #FFF8F0);">
  <div class="mx-auto max-w-6xl px-4 py-28">
    <h2 class="text-4xl font-bold sm:text-5xl" style="letter-spacing: -0.03em; color: var(--color-fcs-black);" data-reveal>{c.cardsTitle}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        c.cards.map((card, i) => (
          <a
            href={localizedPath(lang, card.route)}
            class="group flex flex-col rounded-[10px] p-7 transition-colors duration-150"
            style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);"
            onmouseover="this.style.borderColor='#C8B89A'"
            onmouseout="this.style.borderColor='var(--color-fcs-border)'"
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <h3 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">
              {card.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">
              {card.body}
            </p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold" style="color: var(--color-fcs-green);">
              {card.linkLabel}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Closing CTA band -->
<section style="background: linear-gradient(135deg, #1F1D19 0%, #134B38 60%, #1A6E52 100%); flex-grow: 1;">
  <div
    class="mx-auto max-w-4xl px-4 py-28 text-center"
    data-reveal
  >
    <h2 class="text-4xl font-bold text-white sm:text-5xl" style="letter-spacing: -0.03em;">{c.ctaTitle}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-white/90">{c.ctaBody}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={links.register}
        class="rounded-[6px] bg-fcs-white px-7 py-3 font-semibold transition-colors duration-150 hover:bg-white"
        style="color: var(--color-fcs-green);"
      >{c.ctaPrimary}</a>
      <a
        href={localizedPath(lang, "enroll")}
        class="rounded-[6px] border border-white/70 px-7 py-3 font-semibold text-white transition-colors duration-150 hover:bg-white/10"
      >{c.ctaSecondary}</a>
    </div>
  </div>
</section>
