---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";
import HeroCarousel from "../HeroCarousel.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home;
const events = content[lang].events;

// Simple line icons paired with the four value props, in order.
const featureIcons = [
  // community / people
  "M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m3-1.13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-4a3 3 0 1 0 0-6",
  // badge / accreditation
  "m9 12 2 2 4-4m-3-7.5 2.1 1.5 2.6-.2 1 2.4 2.2 1.4-.6 2.5.6 2.5-2.2 1.4-1 2.4-2.6-.2L12 21.5l-2.1-1.5-2.6.2-1-2.4L4.1 16l.6-2.5L4.1 11l2.2-1.4 1-2.4 2.6.2L12 2.5Z",
  // layers / levels
  "m12 2 9 5-9 5-9-5 9-5Zm9 11-9 5-9-5m18 4-9 5-9-5",
  // sparkle / celebration
  "M12 3v4m0 10v4M3 12h4m10 0h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18",
];
---

<!-- Hero with rotating photo backdrop -->
<HeroCarousel lang={lang}>
  <h1
    class="max-w-3xl text-4xl font-bold text-white drop-shadow-sm sm:text-5xl"
  >
    {c.heroTitle}
  </h1>
  <p class="mt-5 max-w-2xl text-lg text-white/95 drop-shadow-sm">
    {c.heroSubtitle}
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={links.register}
      class="rounded-full bg-white px-6 py-3 font-semibold text-fcs-blue-dark shadow-sm transition hover:-translate-y-0.5 hover:bg-fcs-ink hover:text-white"
      >{c.ctaPrimary}</a
    >
    <a
      href={localizedPath(lang, "programs")}
      class="rounded-full border border-white px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/15"
      >{c.ctaSecondary}</a
    >
  </div>
</HeroCarousel>

<!-- Facts strip -->
<section class="border-b border-gray-100 bg-white">
  <div
    class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-4 py-10 sm:grid-cols-4"
  >
    {
      c.facts.map((f, i) => (
        <div
          class="text-center"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="bg-gradient-to-br from-fcs-blue-dark to-fcs-ink bg-clip-text text-3xl font-bold text-transparent sm:text-4xl">
            {f.value}
          </div>
          <div class="mt-1 text-sm tracking-wide text-gray-500 uppercase">
            {f.label}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Why FCS — value props -->
<section class="mx-auto max-w-6xl px-4 py-20">
  <div class="max-w-2xl" data-reveal>
    <h2 class="text-3xl font-bold sm:text-4xl">{c.featuresTitle}</h2>
    <p class="mt-4 text-lg text-gray-600">{c.featuresSubtitle}</p>
  </div>
  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      c.features.map((f, i) => (
        <div
          class="rounded-2xl border border-gray-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-fcs-blue hover:shadow-lg"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-fcs-blue/15 text-fcs-blue-dark">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={featureIcons[i]} />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-fcs-ink">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- Get-started cards -->
<section class="border-y border-gray-100 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="text-3xl font-bold sm:text-4xl" data-reveal>{c.cardsTitle}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        c.cards.map((card, i) => (
          <a
            href={localizedPath(lang, card.route)}
            class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-fcs-blue hover:shadow-lg"
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <h3 class="text-xl font-semibold text-fcs-blue-dark">
              {card.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600">
              {card.body}
            </p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-fcs-blue-dark">
              {c.ctaSecondary}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Showcase band — scroll-scrubbed parallax photo -->
<section class="relative isolate h-[60vh] overflow-hidden bg-fcs-blue-dark">
  <img
    src="/images/slider/slide-1.jpg"
    alt={c.showcaseAlt}
    loading="lazy"
    decoding="async"
    class="parallax-zoom absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-fcs-ink/70 via-fcs-ink/20 to-transparent"
  >
  </div>
  <div
    class="mx-auto flex h-full max-w-6xl items-end px-4 pb-12"
    data-reveal
  >
    <p class="max-w-xl text-2xl font-semibold text-white drop-shadow sm:text-3xl">
      {c.eventsLead}
    </p>
  </div>
</section>

<!-- Life at FCS — annual events -->
<section class="mx-auto max-w-6xl px-4 py-20">
  <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
    <h2 class="text-3xl font-bold sm:text-4xl">{c.eventsTitle}</h2>
    <a
      href={localizedPath(lang, "events")}
      class="inline-flex items-center gap-1 text-sm font-semibold text-fcs-blue-dark hover:underline"
    >
      {c.eventsCta}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      events.annual.map((name, i) => (
        <div
          class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white px-5 py-4 transition duration-300 hover:-translate-y-1 hover:border-fcs-blue hover:shadow-md"
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 90}ms`}
        >
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-fcs-blue" />
          <span class="font-medium text-fcs-ink">{name}</span>
        </div>
      ))
    }
  </div>
</section>

<!-- Closing CTA band -->
<section class="bg-gradient-to-br from-fcs-blue-dark to-fcs-ink">
  <div
    class="mx-auto max-w-4xl px-4 py-20 text-center text-white"
    data-reveal
  >
    <h2 class="text-3xl font-bold sm:text-4xl">{c.ctaTitle}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-white/90">{c.ctaBody}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={links.register}
        class="rounded-full bg-white px-7 py-3 font-semibold text-fcs-blue-dark shadow-sm transition hover:-translate-y-0.5 hover:bg-fcs-blue hover:text-white"
        >{c.ctaPrimary}</a
      >
      <a
        href={localizedPath(lang, "enroll")}
        class="rounded-full border border-white/70 px-7 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/15"
        >{c.ctaSecondary}</a
      >
    </div>
  </div>
</section>
