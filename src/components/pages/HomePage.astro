---
import { content, links } from "../../i18n/content";
import { localizedPath, type Lang } from "../../i18n/ui";
import HeroCarousel from "../HeroCarousel.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home;
---

<!-- Hero with rotating photo backdrop -->
<HeroCarousel lang={lang}>
  <h1
    class="max-w-3xl text-4xl font-bold text-white drop-shadow-sm sm:text-5xl"
  >
    {c.heroTitle}
  </h1>
  <p class="mt-5 max-w-2xl text-lg text-white/95 drop-shadow-sm">
    {c.heroSubtitle}
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={links.register}
      class="rounded-full bg-white px-6 py-3 font-semibold text-fcs-blue-dark shadow-sm transition hover:bg-fcs-ink hover:text-white"
      >{c.ctaPrimary}</a
    >
    <a
      href={localizedPath(lang, "programs")}
      class="rounded-full border border-white px-6 py-3 font-semibold text-white transition hover:bg-white/15"
      >{c.ctaSecondary}</a
    >
  </div>
</HeroCarousel>

<!-- Facts strip -->
<section class="border-b border-gray-100 bg-white">
  <div
    class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-4 py-8 sm:grid-cols-4"
  >
    {
      c.facts.map((f) => (
        <div class="text-center">
          <div class="text-2xl font-bold text-fcs-blue-dark">{f.value}</div>
          <div class="mt-1 text-sm text-gray-500">{f.label}</div>
        </div>
      ))
    }
  </div>
</section>

<!-- Get-started cards -->
<section class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-2xl font-bold">{c.cardsTitle}</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {
      c.cards.map((card) => (
        <a
          href={localizedPath(lang, card.route)}
          class="group rounded-xl border border-gray-200 p-6 transition hover:border-fcs-blue hover:shadow-md"
        >
          <h3 class="text-lg font-semibold text-fcs-blue-dark group-hover:underline">
            {card.title}
          </h3>
          <p class="mt-2 text-sm text-gray-600">{card.body}</p>
        </a>
      ))
    }
  </div>
</section>
