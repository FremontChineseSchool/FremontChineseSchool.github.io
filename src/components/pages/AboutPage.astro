---
import { content } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].about;
const regulationsUrl = "https://bit.ly/2yxYRLB";
---

<section style="background: #FFF8F0;" class="mx-auto max-w-3xl px-4 py-14">
  <p class="eyebrow mb-3">About</p>
  <h1 class="text-3xl font-semibold sm:text-4xl" style="letter-spacing: -0.02em; color: var(--color-fcs-black);">{c.title}</h1>

  <!-- Location callout -->
  <div class="mt-6 flex gap-4 rounded-[10px] p-5" style="background: var(--color-fcs-white); border: 1px solid var(--color-fcs-border);">
    <span style="flex-shrink:0; margin-top:2px; color: var(--color-fcs-green);">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    </span>
    <div>
      <h2 class="font-semibold" style="color: var(--color-fcs-black);">{c.locationHeading}</h2>
      <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{c.locationBody}</p>
      <p class="mt-1 text-sm font-medium" style="color: var(--color-fcs-green-dark);">{c.locationDetail}</p>
    </div>
  </div>

  <!-- Content sections -->
  <div class="mt-10 space-y-10">
    {
      c.sections.map((s) => (
        <div>
          <h2 class="text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-3 leading-relaxed" style="color: var(--color-fcs-muted);">{p}</p>
          ))}
        </div>
      ))
    }
  </div>

  <a
    href={regulationsUrl}
    target="_blank"
    rel="noopener"
    class="mt-10 inline-block rounded-[6px] px-5 py-2 text-sm font-semibold transition-colors duration-150"
    style="border: 1.5px solid var(--color-fcs-green); color: var(--color-fcs-green);"
  >{c.regulationsLabel}</a>
</section>
