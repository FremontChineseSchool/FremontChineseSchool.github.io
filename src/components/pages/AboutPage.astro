---
import { content } from "../../i18n/content";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].about;
const regulationsUrl = "https://bit.ly/2yxYRLB";
---

<section class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-bold sm:text-4xl">{c.title}</h1>

  <div class="mt-8 space-y-10">
    {
      c.sections.map((s) => (
        <div>
          <h2 class="text-xl font-semibold text-fcs-blue-dark">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-3 leading-relaxed text-gray-700">{p}</p>
          ))}
        </div>
      ))
    }
  </div>

  <a
    href={regulationsUrl}
    target="_blank"
    rel="noopener"
    class="mt-10 inline-block rounded-full border border-fcs-blue-dark px-5 py-2 text-sm font-semibold text-fcs-blue-dark transition hover:bg-fcs-blue hover:text-white"
    >{c.regulationsLabel}</a
  >
</section>
