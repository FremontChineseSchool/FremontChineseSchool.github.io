---
import { ui, navOrder, localizedPath, type Lang } from "../i18n/ui";
import { links } from "../i18n/content";
import LangSwitch from "./LangSwitch.astro";
import TextSize from "./TextSize.astro";
import SiteSearch from "./SiteSearch.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = navOrder.map((key) => {
  const href = localizedPath(lang, key);
  return { key, href, label: t.nav[key], active: href === current };
});
---

<header
  id="site-header"
  class="group z-50 bg-fcs-green transition-[background-color,box-shadow,backdrop-filter] duration-300 sm:sticky sm:top-0 data-[scrolled]:bg-fcs-green/95 data-[scrolled]:shadow-md data-[scrolled]:backdrop-blur-md"
  style="height:72px;"
>
  <div
    class="mx-auto flex h-full max-w-6xl items-center justify-between px-8"
  >
    <!-- Logo + replay-intro button, grouped so the button sits beside the logo -->
    <div class="flex shrink-0 items-center gap-1">
      <a href={localizedPath(lang, "home")} class="flex items-center gap-3">
        <!-- Condensed FS monogram on small screens, full lockup at sm+. The
             monogram (reused from the favicon) is ~40px vs the 204px wordmark,
             freeing room for the always-visible reading-size control in the
             narrow mobile header. Both recolored white via brightness/invert.
             Decorative (alt=""): the sr-only span names the link. -->
        <img
          src="/favicon.png"
          alt=""
          class="h-[40px] w-[40px] sm:hidden"
          style="filter: brightness(0) invert(1);"
          width="256"
          height="256"
        />
        <img
          src="/images/logo.png"
          alt=""
          class="hidden h-[44px] w-auto sm:block"
          style="filter: brightness(0) invert(1);"
          width="500"
          height="108"
        />
        <span class="sr-only">{t.siteName}</span>
      </a>

      <!-- Replay the calligraphy intro. Hidden by default; the splash script
           reveals it only when JS is available and motion is not reduced. -->
      <button
        id="splash-replay"
        type="button"
        aria-label={t.replayIntro}
        title={t.replayIntro}
        style="display:none"
        class="shrink-0 items-center justify-center rounded-full p-1.5 text-white/70 transition-colors hover:bg-white/15 hover:text-fcs-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/70"
      >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="23 4 23 10 17 10"></polyline>
        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
      </svg>
      </button>
    </div>

    <!-- Desktop nav — centered. Appears at xl (1280): below that the nav + Enroll
         CTA + text-size control + language switch no longer fit on one line, so
         the hamburger menu is used instead (see lg→xl on the toggle below). -->
    <nav aria-label="Primary" class="hidden items-center gap-[2px] xl:flex">
      {
        // Header chrome uses fixed px (not rem) so it stays put when the
        // reading-size control scales the page — the control is meant to
        // enlarge page CONTENT, not the navigation, and a scaling nav would
        // overflow the bar.
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "whitespace-nowrap px-[10px] py-2 transition-colors duration-150",
              "text-[12px] font-semibold uppercase tracking-widest",
              item.active
                ? "text-fcs-white underline underline-offset-4"
                : "text-white hover:text-fcs-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side: Enroll + lang switch + mobile toggle -->
    <div class="flex items-center gap-3">
      <a
        href={localizedPath(lang, 'enroll')}
        class="btn-primary hidden whitespace-nowrap rounded-[6px] px-[16px] py-[8px] text-[11px] font-semibold transition-colors duration-150 sm:inline-block"
      >{t.enrollCta}</a>
      <SiteSearch lang={lang} />
      <TextSize lang={lang} />
      <LangSwitch lang={lang} />

      <!-- Mobile menu toggle (shown below xl, where the full nav won't fit) -->
      <details class="relative xl:hidden">
        <summary
          class="flex cursor-pointer list-none items-center rounded p-2 text-fcs-white hover:bg-white/20"
          aria-label="Menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 z-40 mt-2 w-56 overflow-hidden rounded-lg bg-fcs-green-dark py-2 shadow-lg"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "block px-4 py-2 text-[11px] font-medium transition-colors hover:bg-white/10",
                  item.active
                    ? "text-fcs-white font-semibold"
                    : "text-white",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={localizedPath(lang, 'enroll')}
            class="mt-1 block border-t border-white/10 px-4 py-2 text-[11px] font-semibold"
            style="color: var(--color-fcs-mint);"
          >{t.enrollCta}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Condense the sticky header once the page is scrolled past the hero edge.
  // Uses hysteresis (condense at >80, expand at <24): the sticky header shrinks
  // ~24px when condensed, which shortens the page and shifts scrollY. A single
  // threshold would let that shift bounce scrollY back across the line and the
  // header would oscillate ("spazz"). The gap between the two thresholds is
  // wider than the height change, so a toggle can never re-cross the boundary.
  const header = document.getElementById("site-header");
  if (header) {
    let ticking = false;
    const sync = () => {
      const scrolled = header.hasAttribute("data-scrolled");
      const y = window.scrollY;
      if (!scrolled && y > 80) header.setAttribute("data-scrolled", "");
      else if (scrolled && y < 24) header.removeAttribute("data-scrolled");
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(sync);
        }
      },
      { passive: true },
    );
    sync();
  }
</script>
