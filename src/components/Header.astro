---
import { ui, navOrder, localizedPath, type Lang } from "../i18n/ui";
import { links } from "../i18n/content";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = navOrder.map((key) => {
  const href = localizedPath(lang, key);
  return { key, href, label: t.nav[key], active: href === current };
});
---

<header
  id="site-header"
  class="group sticky top-0 z-50 bg-fcs-green transition-[background-color,box-shadow,backdrop-filter] duration-300 data-[scrolled]:bg-fcs-green/95 data-[scrolled]:shadow-md data-[scrolled]:backdrop-blur-md"
  style="height:56px;"
>
  <div
    class="mx-auto flex h-full max-w-6xl items-center justify-between px-8"
  >
    <!-- Logo -->
    <a href={localizedPath(lang, "home")} class="flex shrink-0 items-center gap-3">
      <img
        src="/images/logo.png"
        alt={t.logoAlt}
        class="h-11 w-auto"
        style="filter: brightness(0) invert(1);"
        width="500"
        height="108"
      />
      <span class="sr-only">{t.siteName}</span>
    </a>

    <!-- Desktop nav — centered -->
    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "px-3 py-2 transition-colors duration-150",
              "text-xs font-medium tracking-wide",
              item.active
                ? "text-fcs-white underline underline-offset-4"
                : "text-white/80 hover:text-fcs-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side: Enroll + lang switch + mobile toggle -->
    <div class="flex items-center gap-3">
      <a
        href={links.register}
        class="hidden rounded-[6px] bg-fcs-orange px-4 py-2 text-[11px] font-semibold text-fcs-white transition-colors duration-150 hover:bg-[#C85A10] sm:inline-block"
      >{t.enrollCta}</a>
      <LangSwitch lang={lang} />

      <!-- Mobile menu toggle -->
      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center rounded p-2 text-fcs-white hover:bg-white/20"
          aria-label="Menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 z-40 mt-2 w-56 overflow-hidden rounded-lg bg-fcs-green-dark py-2 shadow-lg"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "block px-4 py-2 text-[11px] font-medium transition-colors hover:bg-white/10",
                  item.active
                    ? "text-fcs-white font-semibold"
                    : "text-white/80",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={links.register}
            class="mt-1 block border-t border-white/10 px-4 py-2 text-[11px] font-semibold text-fcs-orange"
          >{t.enrollCta}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Condense the sticky header once the page is scrolled past the hero edge.
  // Uses hysteresis (condense at >80, expand at <24): the sticky header shrinks
  // ~24px when condensed, which shortens the page and shifts scrollY. A single
  // threshold would let that shift bounce scrollY back across the line and the
  // header would oscillate ("spazz"). The gap between the two thresholds is
  // wider than the height change, so a toggle can never re-cross the boundary.
  const header = document.getElementById("site-header");
  if (header) {
    let ticking = false;
    const sync = () => {
      const scrolled = header.hasAttribute("data-scrolled");
      const y = window.scrollY;
      if (!scrolled && y > 80) header.setAttribute("data-scrolled", "");
      else if (scrolled && y < 24) header.removeAttribute("data-scrolled");
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(sync);
        }
      },
      { passive: true },
    );
    sync();
  }
</script>
