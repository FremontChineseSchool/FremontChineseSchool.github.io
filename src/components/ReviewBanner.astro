---
// Header for the `-diff` review pages. Explains what the reader is looking at,
// links to the live page for side-by-side comparison, and lists the
// cross-cutting review notes.
//
// Review-only: removed along with the `-diff` routes.
import { localizedPath, type Lang } from "../i18n/ui";
import type { ReviewNote as ReviewNoteType } from "../data/proposed-changes";
import ReviewNote from "./ReviewNote.astro";

interface Props {
  lang: Lang;
  /** Route key of the live page this one proposes to replace. */
  liveRouteKey: string;
  notes: ReviewNoteType[];
  /** How many items on this page carry a change. */
  changeCount: number;
}
const { lang, liveRouteKey, notes, changeCount } = Astro.props;
const isZh = lang === "zh";

const copy = isZh
  ? {
      eyebrow: "審閱用版本",
      title: "修訂版本",
      body: `本頁為提議中的修訂版本，尚未上線。目前的線上版本完全未更動，可另開分頁對照閱讀。本頁共有 ${changeCount} 處修改，皆以金色外框標示。`,
      liveLink: "開啟目前線上版本 →",
      legendTitle: "標示說明",
    }
  : {
      eyebrow: "For review",
      title: "Proposed version",
      body: `This is a proposed revision that is not live. The current page is untouched — open it in another tab to compare side by side. ${changeCount} item${changeCount === 1 ? "" : "s"} on this page ${changeCount === 1 ? "has" : "have"} changes, each outlined in gold.`,
      liveLink: "Open the current live page →",
      legendTitle: "What the labels mean",
    };

const legend = isZh
  ? [
      ["需要確認", "需要學校決定，或影響網站以外的資料。"],
      ["編輯判斷", "我們作的取捨，可能有其他合理選擇。"],
      ["補充說明", "背景資訊或尚未解決的疑問。"],
    ]
  : [
      ["Needs a decision", "Requires a call from the school, or reaches beyond the website."],
      ["Judgment call", "A choice we made that could reasonably have gone another way."],
      ["For information", "Background, or a question we could not resolve ourselves."],
    ];
---

<div class="mx-auto max-w-3xl px-4 pt-10">
  <div class="rounded-[10px] p-5 sm:p-6" style="background: var(--color-fcs-green-light); border: 2px solid var(--color-fcs-green);">
    <p class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-fcs-green);">{copy.eyebrow}</p>
    <h2 class="mt-1 text-xl font-semibold" style="color: var(--color-fcs-green-dark);">{copy.title}</h2>
    <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-fcs-muted);">{copy.body}</p>

    <a
      href={localizedPath(lang, liveRouteKey)}
      class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold hover:underline"
      style="color: var(--color-fcs-green);"
    >{copy.liveLink}</a>

    <div class="mt-5 border-t pt-4" style="border-color: var(--color-fcs-green);">
      <p class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-fcs-muted);">{copy.legendTitle}</p>
      <ul class="mt-2 space-y-1">
        {legend.map(([label, meaning]) => (
          <li class="text-xs leading-relaxed" style="color: var(--color-fcs-muted);">
            <span class="font-bold uppercase" style="color: var(--color-fcs-green-dark);">{label}</span>
            {" — "}{meaning}
          </li>
        ))}
      </ul>
    </div>

    {notes.length > 0 && (
      <div class="mt-4 space-y-2">
        {notes.map((n) => <ReviewNote lang={lang} level={n.level} text={n[lang]} />)}
      </div>
    )}
  </div>
</div>
