---
import { ui, navOrder, localizedPath, type Lang } from "../i18n/ui";
import { links, contactInfo } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = 2026;
---

<footer class="mt-16" style="background: linear-gradient(to bottom, #1C1208, #0D0A04);">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-8 py-12 sm:grid-cols-2 lg:grid-cols-3"
  >
    <div>
      <p
        class="text-[10px] font-semibold uppercase tracking-[0.14em]"
        style="color: #D4980A;"
      >{t.siteName}</p>
      <p class="mt-3 text-sm" style="color: rgba(255,248,240,0.65);">{t.tagline}</p>
      <p class="mt-4 text-sm" style="color: rgba(255,248,240,0.65);">{contactInfo.classroom}</p>
      <p class="text-sm" style="color: rgba(255,248,240,0.65);">{contactInfo.voicemail}</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p
        class="mb-3 text-[10px] font-semibold uppercase tracking-[0.14em]"
        style="color: #D4980A;"
      >Links</p>
      <ul class="space-y-2">
        {
          navOrder.map((key) => (
            <li>
              <a
                class="transition-colors duration-150"
                style="color: rgba(255,248,240,0.65);"
                onmouseover="this.style.color='rgba(255,248,240,1)'"
                onmouseout="this.style.color='rgba(255,248,240,0.65)'"
                href={localizedPath(lang, key)}
              >
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm">
      <p
        class="mb-3 text-[10px] font-semibold uppercase tracking-[0.14em]"
        style="color: #D4980A;"
      >Connect</p>
      <a
        class="inline-flex items-center gap-2 transition-colors duration-150"
        style="color: rgba(255,248,240,0.65);"
        onmouseover="this.style.color='rgba(255,248,240,1)'"
        onmouseout="this.style.color='rgba(255,248,240,0.65)'"
        href={links.facebook}
        rel="noopener"
        target="_blank"
      >
        Facebook
      </a>
      <p class="mt-4" style="color: rgba(255,248,240,0.65);">{t.footer.nonprofit}</p>
    </div>
  </div>

  <div
    class="border-t py-4 text-center text-xs"
    style="border-color: rgba(255,248,240,0.1); color: rgba(255,248,240,0.35);"
  >
    © {year} {t.siteName}. {t.footer.rights}
  </div>
</footer>
