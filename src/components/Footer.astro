---
import { ui, navOrder, localizedPath, type Lang } from "../i18n/ui";
import { links, contactInfo } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = 2026;

const bodyText = "color: rgba(236,230,214,0.72);";
const headStyle = "color: var(--color-fcs-mint);";

// Footer-only nav entries, appended after `navOrder` in the Links column.
// Kept out of `navOrder` because that also drives the header, which stays a
// compact seven items; the footer can afford to be a fuller sitemap. Both
// pages are otherwise reachable only contextually (from Programs, Enroll,
// Student Resources, and About).
const footerOnlyLinks = ["electives", "teachers"] as const;
---

<footer style="background: linear-gradient(to bottom, #221F1A, #15120E);">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-8 py-12 sm:grid-cols-2 lg:grid-cols-4"
  >
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em]" style={headStyle}>{t.siteName}</p>
      <p class="mt-3 text-sm" style={bodyText}>{t.tagline}</p>
      <p class="mt-4 text-sm" style={bodyText}>{contactInfo.classroom}</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em]" style={headStyle}>{t.footer.links}</p>
      <ul class="space-y-2">
        {
          navOrder.map((key) => (
            <li>
              <a class="footer-link transition-colors duration-150" href={localizedPath(lang, key)}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
        {
          footerOnlyLinks.map((key) => (
            <li>
              <a class="footer-link transition-colors duration-150" href={localizedPath(lang, key)}>
                {t.footer[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em]" style={headStyle}>{t.footer.resources}</p>
      <ul class="space-y-2">
        <li>
          <a href={lang === 'zh' ? '/zh/news' : '/news'} class="footer-link transition-colors duration-150"
          >{lang === 'zh' ? '最新消息' : 'News & Updates'}</a>
        </li>
        <li>
          <a href={localizedPath(lang, 'ac-resources')} class="footer-link transition-colors duration-150"
          >{t.footer.acResources}</a>
        </li>
        <li>
          <a href={localizedPath(lang, 'staff-resources')} class="footer-link transition-colors duration-150"
          >{t.footer.staffResources}</a>
        </li>
        <li>
          <a href={`${localizedPath(lang, 'staff-resources')}#ta-resources`} class="footer-link transition-colors duration-150"
          >{t.footer.taResources}</a>
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em]" style={headStyle}>{t.footer.connect}</p>
      <div class="flex items-center gap-3">
        <a
          href={links.facebook}
          rel="noopener"
          target="_blank"
          aria-label="Facebook"
          title="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/80 transition-colors duration-150 hover:bg-white/20 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8.5H16l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46H16.5V4.35c-.26-.03-1.15-.11-2.19-.11-2.17 0-3.66 1.32-3.66 3.75v2.1H8.2v3H10.65V22h2.85Z"/></svg>
        </a>
        <a
          href={links.instagram}
          rel="noopener"
          target="_blank"
          aria-label="Instagram"
          title="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/80 transition-colors duration-150 hover:bg-white/20 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
        </a>
      </div>
      <p class="mt-4" style={bodyText}>{t.footer.nonprofit}</p>
    </div>
  </div>

  <div
    class="border-t py-4 text-center text-xs"
    style="border-color: rgba(236,230,214,0.12); color: rgba(236,230,214,0.55);"
  >
    © {year} {t.siteName}. {t.footer.rights}
  </div>
</footer>
