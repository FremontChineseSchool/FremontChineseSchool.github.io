---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui, routes, localizedPath, type Lang } from "../i18n/ui";
import { descriptions, contactInfo, content } from "../i18n/content";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];

// --- SEO ----------------------------------------------------------------
const site = Astro.site!; // set in astro.config.mjs

// Resolve the current route key from the path (locale-stripped) so we can look
// up a per-page meta description and detect the homepage without each route
// wrapper having to pass anything extra.
const bareSlug = Astro.url.pathname
  .replace(/^\/+|\/+$/g, "")
  .replace(/^zh\/?/, "");
const routeKey = Object.keys(routes).find((k) => routes[k] === bareSlug) ?? "home";
const isHome = routeKey === "home";

const fullTitle = isHome ? t.homeTitle : `${title} · ${t.siteName}`;
const ogTitle = isHome ? t.homeTitle : title;
const metaDescription = description ?? descriptions[lang][routeKey] ?? t.tagline;

// Canonical + hreflang. Trailing slashes match Astro's directory output and the
// generated sitemap, so canonical points at the final URL (no redirect hop).
const enPath = bareSlug ? `/${bareSlug}/` : "/";
const zhPath = bareSlug ? `/zh/${bareSlug}/` : "/zh/";
const enURL = new URL(enPath, site).href;
const zhURL = new URL(zhPath, site).href;
const canonicalURL = lang === "zh" ? zhURL : enURL;

const ogImage = new URL("/images/slider/slide-3.jpg", site).href;
const ogLocale = lang === "zh" ? "zh_TW" : "en_US";
const ogLocaleAlt = lang === "zh" ? "en_US" : "zh_TW";

// Organization structured data (site-wide; describes the school itself).
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "Fremont Chinese School",
  alternateName: "費利蒙中文學校",
  url: new URL("/", site).href,
  logo: new URL("/images/logo.png", site).href,
  image: ogImage,
  foundingDate: "1972",
  description: descriptions.en.home,
  telephone: "+1-510-468-9905",
  email: contactInfo.registration,
  address: {
    "@type": "PostalAddress",
    streetAddress: "41800 Blacow Road",
    addressLocality: "Fremont",
    addressRegion: "CA",
    postalCode: "94538",
    addressCountry: "US",
  },
  sameAs: ["https://www.facebook.com/fremontchineseschool"],
};
---

<!doctype html>
<html lang={lang === "zh" ? "zh-Hant" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Reading-size: apply a saved text-size choice before first paint so the
         page never flashes at the default size first. Sets the root font-size
         (a percentage); all body text is rem-based, so this zooms the whole
         site. TextSize.astro (in the header) writes the `fcs-text-scale` key. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("fcs-text-scale");
          if (s) document.documentElement.style.fontSize = s + "%";
        } catch (e) {}
      })();
    </script>

    <!-- Fonts: preconnect warms the connection; stylesheet discovered in <head> (not via render-blocking CSS @import). display=swap avoids FOIT. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Locale alternates -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="zh-Hant" href={zhURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline
    ></script>

    <script defer src="https://cloud.umami.is/script.js" data-website-id="c440576c-bdf1-42b6-abb5-74b71293e79d"></script>
  </head>
  <body class="flex min-h-screen flex-col" style="background: var(--color-fcs-white);">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow"
      >{t.skipToContent}</a
    >
    {/* On mobile (<sm) the header has no room for the Enroll button, so we pin
        the announcement banner + header together as one sticky unit — keeping an
        Enroll CTA visible at any scroll. At sm+ this wrapper becomes
        `display:contents` (no box), so the banner scrolls away and the header
        pins itself exactly as before. */}
    <div class="sticky top-0 z-50 sm:contents">
      {content[lang].home.announcements.length > 0 && (
        <div id="fcs-announcement" class="px-4 py-2 text-xs font-medium" style="background: var(--color-fcs-green-dark); color: #EFE9DB;">
          {content[lang].home.announcements.map((a, i) => (
            <div class="fcs-announcement-item flex items-center justify-center gap-x-3" style={i === 0 ? undefined : 'display:none;'}>
              <span class="min-w-0 truncate">{a.text}</span>
              <a
                href={localizedPath(lang, a.href)}
                class="btn-primary btn-shimmer shrink-0 rounded-full px-3 py-0.5 text-xs font-semibold transition-colors"
              >{a.cta}</a>
            </div>
          ))}
        </div>
      )}
      <Header lang={lang} />
    </div>
    <main id="main" class="flex-1 flex flex-col" data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<script>
  // Alternate between announcement banner messages (if there's more than one)
  // every few seconds. A plain display swap — no animation to gate behind
  // prefers-reduced-motion.
  const announcementItems = document.querySelectorAll<HTMLElement>(".fcs-announcement-item");
  if (announcementItems.length > 1) {
    let activeIndex = 0;
    setInterval(() => {
      announcementItems[activeIndex].style.display = "none";
      activeIndex = (activeIndex + 1) % announcementItems.length;
      announcementItems[activeIndex].style.display = "flex";
    }, 6000);
  }
</script>

<script>
  // Reveal [data-reveal] elements as they scroll into view. Under reduced-motion
  // (or without IntersectionObserver) everything is shown immediately.
  const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduce || !("IntersectionObserver" in window)) {
    els.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
